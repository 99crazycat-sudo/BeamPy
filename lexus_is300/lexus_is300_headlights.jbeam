{
"fullsize_headlight_R": {
	"information":{
		"authors":"gabester",
		"name":"Gavril Grand Marshal Right Headlight",
	}
    "slotType" : "fullsize_headlight_R",
	"selfCollisionThickness":0.02,
	"remoteCollisionThickness":0.06,
	"scalenodeWeight":0.95,
	"scalebeamSpring":0.75,
	"scalebeamDamp":0.73,
	"scalebeamDeform":0.36,
	"scalebeamStrength":0.65,
	"flexbodies": [
		 ["mesh", "[group]:", "nonFlexMaterials"],
		 ["fullsize_headlightframe_R", ["fullsize_headlight_R"]],
		 {"deformGroup":"fullsize_headlightglass_R_break", "deformMaterialBase":"fullsize_glass", "deformMaterialDamaged":"fullsize_glass_dmg"}
		 ["fullsize_headlightglass_R", ["fullsize_headlight_R"]],
		 {"deformGroup":"fullsize_headlightglass_R_break", "deformMaterialBase":"fullsize_lights", "deformMaterialDamaged":"fullsize_lights_dmg"}
		 ["fullsize_headlight_R", ["fullsize_headlight_R"]],
		 {"deformGroup":""},
	],	
	"props": [
		["func"      , "mesh"              , "idRef:", "idX:", "idY:"            , "baseRotation"        , "rotation"                 , "translation"        , "min", "max", "offset", "multiplier"]
		{
			"lightInnerAngle":65
			"lightOuterAngle":120
			"lightBrightness":0.4
			"lightRange":30
			"lightColor":{"r":255, "g":255, "b":200, "a":255}
			"lightAttenuation":{"x":0, "y":1, "z":1}
			"lightCastShadows":true
		}
		//low beams
		["lowhighbeam"    , "SPOTLIGHT"        , "he4r", "he3r", "he2r", {"x":200, "y":-45, "z":-10} , {"x":0, "y":0, "z":0}    , {"x":0, "y":0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":0.3, "y":0.5, "z":-0.05},"deformGroup":"fullsize_headlightglass_R_break"}],
		//high beams
		["highbeam" , 		"SPOTLIGHT"        , "he4r", "he3r", "he2r", {"x":200, "y":-45, "z":-10} , {"x":0, "y":0, "z":0}    , {"x":0, "y":0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":0.85, "y":0.5, "z":-0.05},"lightRange":50,"deformGroup":"fullsize_headlightglass_R_break"}],
		//dim parking light
		["parking" , 		"SPOTLIGHT"        , "he4r", "he3r", "he2r", {"x":200, "y":-45, "z":-10} , {"x":0, "y":0, "z":0}    , {"x":0, "y":0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":0.85, "y":0.5, "z":-0.05},"lightRange":30,"lightBrightness":0.2,"deformGroup":"fullsize_headlightglass_R_break"}],
	 ],
	"nodes": [
		 ["id", "posX", "posY", "posZ"],
		 //--HEADLIGHT--
		 //right
		 {"selfCollision":true}
		 {"collision":true}
		 {"nodeMaterial":"|NM_GLASS"},
		 {"frictionCoef":0.7},
		 {"nodeWeight":2},
		 {"group":"fullsize_headlight_R"},
		 ["he1r", -0.36, -2.12, 0.74],
		 ["he3r", -0.35, -2.14, 0.60],
		 {"nodeMaterial":"|NM_PLASTIC"},
		 ["he2r", -0.78, -2.02, 0.74],
		 ["he4r", -0.78, -2.06, 0.60],
		 ["he5r", -0.62, -2.06, 0.67],
		 {"group":""},
	],
	
	"beams": [
		  ["id1:", "id2:"],
		  {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
		  //--HEADLIGHT--
		  {"beamSpring":1201000,"beamDamp":170},
		  {"beamDeform":44500,"beamStrength":125500},
		  //headlight main shape
		  {"deformGroup":"fullsize_headlightglass_R_break", "deformationTriggerRatio":0.1}
		  //r
		  ["he1r","he2r"],
		  ["he3r","he4r"],
		  ["he1r","he3r"],
		  ["he2r","he4r"],
		  
		  ["he1r","he4r"],
		  ["he2r","he3r"],
		  
		  ["he1r","he5r"],
		  ["he2r","he5r"],
		  ["he3r","he5r"],
		  ["he4r","he5r"],
		  //attach
		  {"beamSpring":1201000,"beamDamp":170},
		  {"beamDeform":36500,"beamStrength":94500},
		  //r
		  {"breakGroup":"fullsize_headlight_a_R"},
		  ["he5r","f15rr"],
		  ["he5r","f15r"],
		  ["he2r","f15rr"],
		  ["he4r","f15rr"],
		  
		  
		  {"breakGroup":"fullsize_headlight_b_R"},
		  ["he1r","f15r"],
		  ["he3r","f15r"],
		  ["he3r","f13rr"],
		  
		  {"breakGroup":""},
		  {"deformGroup":""}
		  
		  //headlight support beams
		  {"beamType":"|SUPPORT", "beamLongBound":4},
		  {"beamSpring":1001000,"beamDamp":150},
		  {"beamLimitSpring":1001000,"beamLimitDamp":150},
		  {"beamDeform":44000,"beamStrength":660000},
		  {"optional":true},
		  ["he2r","h4"],
		  ["he4r","h5"],
		  ["he3r","h4r"],
		  {"optional":false},
		  
		  ["he1r","f10rr"],
		  ["he3r","f6r"],
		  
		  ["he2r","f6r"],
		  ["he4r","f10rr"],
		  
		  {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
		  
	],
	"triangles": [
			["id1:","id2:","id3:"],
			//right headlight
			{"group":"fullsize_headlight_R"},
			["he3r","he1r","he4r"],
			["he4r","he1r","he2r"],
			["he4r","he2r","he5r"],
			["he1r","he5r","he2r"],
			["he3r","he5r","he1r"],
			["he4r","he5r","he3r"],
			{"group":""},
			
			
	],
}
