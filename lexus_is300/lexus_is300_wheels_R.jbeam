		 ["wheel_03a_16x9_RL", ["wheel_RL","wheelhub_RL"], ["wheel_03a"]],
	],
	"nodes": [
		 ["id", "posX", "posY", "posZ"],
		 //rear wheel nodes
		 {"frictionCoef":0.7},
		 {"nodeMaterial":"|NM_METAL"},
		 {"selfCollision":false}
		 {"collision":false}
		 {"nodeWeight":5.7},
		 {"group":"wheelhub_RR"},
		 ["ax1r", -0.66, 1.51, 0.32],
		 {"group":"wheelhub_RL"},
		 ["ax1l", 0.66, 1.51, 0.32],
		 {"selfCollision":false}
		 {"collision":true}
		 {"group":"wheelhub_RR"},
		 ["axwr", -0.91, 1.51, 0.32],
		 {"group":"wheelhub_RL"},
		 ["axwl", 0.91, 1.51, 0.32],
		 {"group":""},
	],
	
	"beams": [
		  ["id1:", "id2:"],
		  {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
		  //rear wheels
		  {"breakGroupType":0},
		  {"beamSpring":8001000,"beamDamp":10},
		  {"beamDeform":165000,"beamStrength":1120000},
		  //{"breakGroup":"wheel_RR"},
		  ["ax1r","axwr"],
		  //{"breakGroup":"wheel_RL"},
		  ["ax1l","axwl"],
		  {"breakGroup":""},
		  {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
		  
	],
	"hubWheels": [
            ["name","group","node1:","node2:","nodeS","nodeArm:","wheelDir"], 
			{"enableTireSideSupportBeams":true},
			
			//general settings
			{"radius":0.345},
			{"hubRadius":0.21},
			{"wheelOffset":-0.045},
			{"hubWidth":0.225},
			{"tireWidth":0.215},
			{"numRays":12},
			
			//hub options
			{"hubBeamSpring":1341000, "hubBeamDamp":10}
			{"beamSpring":1341000, "beamDamp":10},
			{"hubBeamDeform":54000, "hubBeamStrength":148000},
			{"beamDeform":240000,"beamStrength":380000},
			{"hubNodeWeight":0.48},
			{"hubNodeMaterial":"|NM_METAL"},
			{"hubFrictionCoef":0.7},
			
			//tire options
			{"wheelTreadBeamSpring":241000,"wheelTreadBeamDamp":45,"wheelTreadBeamDeform":55000,"wheelTreadBeamStrength":55000},
			{"wheelPeripheryBeamSpring":241000,"wheelPeripheryBeamDamp":45,"wheelPeripheryBeamDeform":55000,"wheelPeripheryBeamStrength":55000},
			{"springExpansion":581000, "dampExpansion":10},
			{"nodeWeight":0.25},
			{"nodeMaterial":"|NM_RUBBER"},
			{"frictionCoef":1.55},
			
			//
			{"pressurePSI":30},
			{"maxPressurePSI":1400},
			{"reinforcementPressurePSI":30},
			{"pressureSpring":761000},
			{"reinforcementPressureSpring":110000},
			{"pressureDamp":45},
			{"reinforcementPressureDamp":45},
			
			//rear
			{"selfCollision":false}
			{"collision":true}
			{"enableHubcaps":false},
			{"axleBeams":["axle_RR"]}
            ["RR", "wheel_RR", "axwr", "ax1r", 9999,  "ax4r", 1, {"speedo" : true}],
			{"axleBeams":["axle_RL"]}
            ["RL", "wheel_RL", "axwl", "ax1l", 9999,  "ax4l",-1]
