{
"fullsize_suspension_R": {
	"information":{
		"authors":"gabester",
		"name":"Gavril Grand Marshal Live Axle Rear Suspension",
	}
    "slotType" : "fullsize_suspension_R",
	"slots": [
		["type", "default", "description"]
		["fullsize_brake_R","fullsize_brake_R", "Gavril Grand Marshal Rear Brakes"],
		["fullsize_wheel_R","fullsize_wheel_R", "Gavril Grand Marshal Rear Wheels"],
		["fullsize_spring_R","fullsize_spring_R", "Gavril Grand Marshal Rear Springs"],
		["fullsize_shock_R","fullsize_shock_R", "Gavril Grand Marshal Rear Shocks"],
		["fullsize_swaybar_R","fullsize_swaybar_R", "Gavril Grand Marshal Rear Sway Bar"],
		["fullsize_differential_R","fullsize_differential_R", "Gavril Grand Marshal Rear Differential"],
	],
	"selfCollisionThickness":0.02,
	"remoteCollisionThickness":0.06,
	"scalenodeWeight":0.95,
	"scalebeamSpring":0.75,
	"scalebeamDamp":0.73,
	"scalebeamDeform":0.36,
	"scalebeamStrength":0.65,
	"flexbodies": [
		 ["mesh", "[group]:", "nonFlexMaterials"],
		 //running gear		 
		 ["fullsize_lowerarm_R", ["fullsize_lowermounts_R","fullsize_axle"]],
		 ["fullsize_upperarm_R", ["fullsize_uppermounts_R","fullsize_axle"]],
		 
		 ["fullsize_axle", ["fullsize_axle","fullsize_engine","fullsize_transmission"]],
		 
	],
	"nodes": [
		 ["id", "posX", "posY", "posZ"],
		 //live axle rear suspension
		 {"frictionCoef":0.7},
		 {"nodeMaterial":"|NM_METAL"},
		 {"selfCollision":false}
		 {"collision":false}
		 {"nodeWeight":5.7},
		 //{"group":"wheelhub_RR"},
		 //["ax1r", -0.695, 1.51, 0.32],
		 //{"group":"wheelhub_RL"},
		 //["ax1l", 0.695, 1.51, 0.32],
		 {"group":"fullsize_axle"},
		 ["ax2r", -0.66, 1.53, 0.40],
		 ["ax2l", 0.66, 1.53, 0.40],
		 ["ax3r", -0.66, 1.41, 0.32],
		 ["ax3l", 0.66, 1.41, 0.32],
		 {"collision":true}
		 ["ax1", 0.0, 1.61, 0.32],
		 ["ax2", 0.0, 1.51, 0.47],
		 ["ax3", 0.0, 1.31, 0.32],
		 //wheel nodes
		 {"selfCollision":false}
		 {"collision":true}
		 {"frictionCoef":0.7},
		 {"nodeMaterial":"|NM_METAL"},
		 //{"group":"wheelhub_RR"},
		 //["axwr", -0.93, 1.51, 0.32],
		 //{"group":"wheelhub_RL"},
		 //["axwl", 0.93, 1.51, 0.32],
		 //extra axis nodes
		 ["ax4r", -0.66, 1.56, 0.24],
		 ["ax4l", 0.66, 1.56, 0.24],
		 
		 {"group":"fullsize_shockbottom_R"},
		 //shock mounting nodes
		 {"nodeWeight":5.7},
		 ["axshr", -0.46, 1.56, 0.24],
		 ["axshl", 0.46, 1.56, 0.24],
		 {"group":""},
	],
	
	"beams": [
		  ["id1:", "id2:"],
		  {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
		  //live axle suspension		  
		  {"beamSpring":7501000,"beamDamp":80},
		  {"beamDeform":165000,"beamStrength":460000},
		  ["ax2r","ax2"],
		  ["ax2","ax2l"],
		  ["ax3r","ax3"],
		  ["ax3","ax3l"],
		  //
		  ["ax2l","ax3l"],
		  ["ax1","ax2"],
		  ["ax1","ax3"],
		  ["ax2","ax3"],
		  ["ax2r","ax3r"],
		  
		  //crossing
		  ["ax2r","ax1"],
		  ["ax2l","ax1"],
		  ["ax3r","ax1"],
		  ["ax3l","ax1"],
		  
		  ["ax3r","ax2"],
		  ["ax3l","ax2"],
		  
		  ["ax2r","ax3"],
		  ["ax2l","ax3"],
		  
		  
		  {"optional":true},
		  {"beamSpring":7501000,"beamDamp":80},
		  {"beamDeform":215000,"beamStrength":340000},
		  {"breakGroup":"wheel_RR"},
		  //["ax1r","axwr"],
		  ["ax2r","axwr"],
		  ["ax3r","axwr"],
		  
		  ["ax1r","ax3"],
		  ["ax1r","ax2"],
		  ["ax1r","ax1", {"name":"axle_RR"}],
		  ["ax1r","ax2r"],
		  ["ax1r","ax3r"],//right rear brake arm
		  
		  {"breakGroup":"wheel_RL"},
		  //["ax1l","axwl"],
		  ["ax2l","axwl"],
		  ["ax3l","axwl"],
		  
		  ["ax1l","ax3"],
		  ["ax1l","ax2"],
		  ["ax1l","ax1", {"name":"axle_RL"}],
		  ["ax1l","ax2l"],
		  ["ax1l","ax3l"],//left rear brake arm
		  {"beamSpring":7501000,"beamDamp":80},
		  {"beamDeform":215000,"beamStrength":340000},
		  //to wheels
		  {"breakGroup":"wheel_RR"},
		  ["axwr","ax1"],
		  ["axwr","ax2"],
		  ["axwr","ax3"],
		  ["axshr","axwr"],
		  ["ax4r","axwr"],
		  {"breakGroup":"wheel_RL"},
		  ["axwl","ax1"],
		  ["axwl","ax2"],
		  ["axwl","ax3"],
		  ["axshl","axwl"],
		  ["ax4l","axwl"],
		  
		  //shock mounts
		  {"breakGroup":"wheel_RR"},
		  ["axshr","ax1r"],
		  {"breakGroup":"wheel_RL"},
		  ["axshl","ax1l"],
		  {"optional":false},
		  {"breakGroup":""},
		  {"beamSpring":7501000,"beamDamp":80},
		  {"beamDeform":215000,"beamStrength":340000},
		  ["axshr","ax2r"],
		  ["axshr","ax3r"],
		  ["axshr","ax1"],
		  ["axshr","ax2"],
		  ["axshr","ax3"],
		  
		  ["axshl","ax2l"],
		  ["axshl","ax3l"],
		  ["axshl","ax1"],
		  ["axshl","ax2"],
		  ["axshl","ax3"],
		  
		  //extra 
		  
		  ["ax4r","ax1r"],
		  ["ax4r","ax2r"],
		  ["ax4r","ax3r"],
		  ["ax4l","ax1l"],
		  ["ax4l","ax2l"],
		  ["ax4l","ax3l"],
		  ["ax4r","ax1"],
		  ["ax4r","ax2"],
		  ["ax4r","ax3"],
		  ["ax4l","ax1"],
		  ["ax4l","ax2"],
		  ["ax4l","ax3"],
		  
		  ["ax4r","axshr"],
		  ["ax4l","axshl"],
		  
		  
		  {"beamSpring":7501000,"beamDamp":200},
		  {"beamDeform":115000,"beamStrength":280000},
		  //locator arms
		  ["ax4r","rx1r"],
		  ["ax4l","rx1l"],
		  ["axshr","rx1r"],
		  ["axshl","rx1l"],
		  
		  {"optional":true},
		  {"breakGroupType":1},
		  {"beamSpring":1001000,"beamDamp":600},
		  {"breakGroup":"wheel_RR"},
		  ["axwr","rx1r"],
		  {"breakGroup":"wheel_RL"},
		  ["axwl","rx1l"],
		  {"optional":false},
		  {"breakGroupType":0},
		  {"breakGroup":""},
		  {"beamSpring":6401000,"beamDamp":200},
		  ["ax2r","rx2r"],
		  ["ax2l","rx2l"],
		  
		  //driveshaft
		  {"beamSpring":0,"beamDamp":0,"beamDeform":2500,"beamStrength":3500},
		  {"beamLimitSpring":5001000,"beamLimitDamp":800},
		  {"beamPrecompression":1.0, "beamType":"|BOUNDED", "beamLongBound":0.01, "beamShortBound":0.005},
		  ["ax3","tra1", {"name":"driveshaft"}],
		  
		  //rear limiters
		  {"beamSpring":0,"beamDamp":0,"beamDeform":150000,"beamStrength":500000},
		  {"beamLimitSpring":501000,"beamLimitDamp":800},
		  {"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":0.3, "beamShortBound":0.36},
		  
		  ["ax2r","r2rr"],
		  ["ax2l","r2ll"],
		  ["ax3r","r2rr"],
		  ["ax3l","r2ll"],
		  
		  {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
		  
	],

	"hubWheels": [
            ["name","group","node1:","node2:","nodeS","nodeArm:","wheelDir"], 
			{"propulsed":1}
	],
}
"fullsize_brake_R": {
	"information":{
		"authors":"gabester",
		"name":"Gavril Grand Marshal Rear Brakes",
	}
    "slotType" : "fullsize_brake_R",
	"scalenodeWeight":0.95,
	"scalebeamSpring":0.75,
	"scalebeamDamp":0.73,
	"scalebeamDeform":0.36,
	"scalebeamStrength":0.65,
	"flexbodies": [
		 ["mesh", "[group]:", "nonFlexMaterials"],
		 //brake discs
		 ["fullsize_brakedisc_RR", ["wheel_RR","wheelhub_RR"], ["fullsize"]],
		 ["fullsize_brakedisc_RL", ["wheel_RL","wheelhub_RL"], ["fullsize"]],
	],
	"hubWheels": [
            ["name","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
			//brakes
			{"enableABS":true}
			{"ABSthreshold":4}
			{"brakeTorque":1000},
			{"parkingTorque":3600},
	],
	"engine": {
		"ABSrate":15
	},
}
