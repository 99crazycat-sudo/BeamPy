"fullsize_swaybar_R": {
	"information":{
		"authors":"gabester",
		"name":"Gavril Grand Marshal Rear Sway Bar",
	}
    "slotType" : "fullsize_swaybar_R",
	"selfCollisionThickness":0.02,
	"remoteCollisionThickness":0.06,
	"scalenodeWeight":0.95,
	"scalebeamSpring":0.75,
	"scalebeamDamp":0.73,
	"scalebeamDeform":0.36,
	"scalebeamStrength":0.65,
	"flexbodies": [
		 ["mesh", "[group]:", "nonFlexMaterials"],
		 ["fullsize_swaybar_R", ["fullsize_uppermounts_R","fullsize_axle"]],
	],
	"nodes": [
		 ["id", "posX", "posY", "posZ"],
		 
		 //rear anti-roll
		 {"frictionCoef":0.7},
		 {"nodeMaterial":"|NM_METAL"},
		 {"collision":false}
		 {"selfCollision":false},
		 {"group":""},
		 {"nodeWeight":2.6},
		 ["arbr", 0.0, 1.51, 0.46],
	],
	
	"beams": [
		  ["id1:", "id2:"],
		  {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},

		  //--REAR ANTI-ROLL--
		  {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
	      {"beamSpring":5501000,"beamDamp":200},
		  {"beamDeform":300000,"beamStrength":1100000},
		  //rigid beams
		  {"breakGroupType":1},
		  {"optional":true},
		  {"breakGroup":"wheel_RR"},
		  ["arbr","ax1r"],
		  {"breakGroup":"wheel_RL"},
		  ["arbr","ax1l"],
		  {"optional":false},
		  {"breakGroup":""},
		  {"breakGroupType":0},
	      {"beamSpring":451000,"beamDamp":10},
		  //rear anti-roll
		  ["arbr","r1rr"],
		  ["arbr","r1ll"],
		  
		  //damping
		  ["arbr","r1",{"beamSpring":0,"beamDamp":200}],
		  
		  {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
	],
	"triangles": [
			["id1:","id2:","id3:"],
			{"group":""},
			
			
	],
}
"fullsize_differential_R": {
	"information":{
		"authors":"gabester",
		"name":"Gavril Grand Marshal Rear Differential",
	}
	"differentials": [
			["wheelName1", 	"wheelName2", "type", "state", "closedTorque", "engineTorqueCoef"],
			["RL","RR", "open", "open", 0, 1]
	],
	"engine":{
		"differential":3.27,
		"axleFriction":12
		},
    "slotType" : "fullsize_differential_R",
}
