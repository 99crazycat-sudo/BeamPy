		  {"beamPrecompression":1.29, "beamType":"|BOUNDED", "beamLongBound":0.08, "beamShortBound":0.45}, 
		  {"beamSpring":32000,"beamDeform":142000,"beamStrength":228000},
		  {"beamDamp":0},
		  {"beamLimitSpring":211000,"beamLimitDamp":2500},
		  ["axshr","r1rr",{"beamDampRebound":0}],
		  ["axshl","r1ll",{"beamDampRebound":0}],
		  
		  {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
	],
